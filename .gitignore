/FL_code/data/
*.npy
*.npz
*.pkl
*.zip
*.rar

# Generated training and experiment records
# Archive source, configs, summaries, and plots are versioned; duplicated aggregate records and
# heavyweight training/database artifacts remain local.
/Experiments/Archive/**/records/
/Experiments/Archive/**/*.db
/Experiments/Archive/**/*.pt
/Experiments/Archive/**/*.pth
/Experiments/Archive/**/*.ckpt
/Experiments/Archive/**/elements/
/Experiments/Archive/**/raw_elements/
/Experiments/Protocol_test/analysis_plots/**/*.png
/Experiments/statistical_relation_boosting/results/logs/
/Experiments/Protocol_test/Archive_final_experiment_reports/**/results/raw_elements/
/Experiments/Protocol_test/Archive_final_experiment_reports/**/results/archive/
/Experiments/Protocol_test/Archive_final_experiment_reports/**/results/records/
/Experiments/Protocol_test/Archive_final_experiment_reports/**/results/*/records/
/Experiments/Protocol_test/Archive_final_experiment_reports/**/runs/
/Experiments/Protocol_test/Runs_exp/

# Intentionally local source and test files
Experiments/statistical_relation_boosting/results/history/*/logs/*

/.claude/
/.pytest_cache/
/archived_tests/
