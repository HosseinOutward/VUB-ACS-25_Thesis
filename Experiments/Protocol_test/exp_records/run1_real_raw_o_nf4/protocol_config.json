{
  "implementation": "FL_code.cancer_protocol.cancer_protocol.WZCancerProtocol",
  "protocol_name_full": "wz_cancer",
  "options": null,
  "warmup_round_codecs": [
    "I",
    "I",
    "O|bins_per_plane=8|num_planes=3",
    "O|bins_per_plane=4|num_planes=3"
  ],
  "routine_round_codecs": [
    "O|bins_per_plane=3|num_planes=3",
    "F",
    "F",
    "F",
    "F"
  ],
  "max_per_client_recons_history": 5,
  "round_codecs": {
    "F": {
      "implementation": "FL_code.cancer_protocol.cancer_protocol.F_RoundCodec",
      "options": null
    },
    "I": {
      "implementation": "FL_code.FL_core.codec.IdentityRoundCodec",
      "options": null
    },
    "O|bins_per_plane=3|num_planes=3": {
      "implementation": "FL_code.cancer_protocol.cancer_protocol.Oracle_RoundCodec",
      "options": {
        "bins_per_plane": 3,
        "num_planes": 3
      }
    },
    "O|bins_per_plane=4|num_planes=3": {
      "implementation": "FL_code.cancer_protocol.cancer_protocol.Oracle_RoundCodec",
      "options": {
        "bins_per_plane": 4,
        "num_planes": 3
      }
    },
    "O|bins_per_plane=8|num_planes=3": {
      "implementation": "FL_code.cancer_protocol.cancer_protocol.Oracle_RoundCodec",
      "options": {
        "bins_per_plane": 8,
        "num_planes": 3
      }
    }
  },
  "quantizer_defaults": {
    "outlier_threshold": null,
    "marginal_loss": false,
    "max_side_info_count": 5,
    "pretrain_pth_dir": "FL_code/data/pre_trained_pth",
    "train_epochs": 80,
    "reconst_ld": 300.0,
    "train_sample_size": 300000,
    "train_batch_size": 50000,
    "lr": 0.003,
    "lr_step": 40,
    "tau": 1.0,
    "quantizer_train_repeats": 2,
    "prior_train_repeats": 2,
    "training_progress_bar": false,
    "training_log_every_epochs": null,
    "tf32": false,
    "fused_optimizer": true,
    "mixed_precision": false,
    "source_perturbation": "none",
    "shared_heads": true,
    "prior_context": "hard",
    "prior_probabilities": "categorical",
    "hidden_dim": 100,
    "layers": 3
  },
  "refresh_frozen_si": true,
  "retrained_prior_uses_server_si": true
}